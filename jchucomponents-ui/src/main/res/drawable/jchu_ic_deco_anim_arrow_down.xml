<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:name="caret_up"
            android:width="24dp"
            android:height="24dp"
            android:viewportWidth="24"
            android:viewportHeight="24">
            <group android:name="caret01" android:rotation="90" android:translateX="12" android:translateY="12">
                <group android:name="caret_l" android:rotation="45">
                    <group android:name="caret_l_pivot" android:translateY="4">
                        <group android:name="caret_l_rect_position" android:translateY="-1">
                            <path android:name="caret_l_rect" android:fillColor="#000000" android:pathData="M -1,-3 a 1,1 0 0,1 1,-1 l 0,0 a 1,1 0 0,1 1,1 l 0,6 a 1,1 0 0,1 -1,1 l 0,0 a 1,1 0 0,1 -1,-1 Z" />
                        </group>
                    </group>
                </group>
                <group android:name="caret_r" android:rotation="-45">
                    <group android:name="caret_r_pivot" android:translateY="-4">
                        <group android:name="caret_r_rect_position" android:translateY="1">
                            <path android:name="caret_r_rect" android:fillColor="#000000" android:pathData="M -1,-3 a 1,1 0 0,1 1,-1 l 0,0 a 1,1 0 0,1 1,1 l 0,6 a 1,1 0 0,1 -1,1 l 0,0 a 1,1 0 0,1 -1,-1 Z" />
                        </group>
                    </group>
                </group>
            </group>
        </vector>
    </aapt:attr>
    <target android:name="caret01">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="300" android:interpolator="@android:interpolator/fast_out_slow_in" android:pathData="M 12,12 c 0,0 0,0 0,0" android:propertyXName="translateX" android:propertyYName="translateY" />
        </aapt:attr>
    </target>
    <target android:name="caret_l">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="300" android:interpolator="@android:interpolator/fast_out_slow_in" android:propertyName="rotation" android:valueFrom="-45" android:valueTo="45" android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="caret_r">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="300" android:interpolator="@android:interpolator/fast_out_slow_in" android:propertyName="rotation" android:valueFrom="45" android:valueTo="-45" android:valueType="floatType" />
        </aapt:attr>
    </target>
</animated-vector>
